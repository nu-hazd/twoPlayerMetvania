[sub_resource type="GDScript" id="GDScript_6mpvv"]
script/source = "extends Panel


@onready var player_two: Player = $\"..\"

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	$DashC.text = \"[table=2]
[cell][color=gold]HasDash:[/color][/cell][cell][color=white]%s[/color][/cell]
[cell][color=red]iFrames:[/color][/cell][cell][color=white]%s[/color][/cell]
[cell][color=green]State:[/color][/cell][cell][color=white]%s[/color][/cell]
[cell][color=blue]dashCooldown:[/color][/cell][cell][color=white]%s[/color][/cell]
[cell][color=blue]vel:[/color][/cell][cell][color=white]%s[/color][/cell]
[/table]\" % [
	player_two.stats[Player.STATS.HAS_DASH],
	player_two.iFrames,
	player_two.state_machine.currentState.name,
	player_two.dashCooldown,
	player_two.velocity
]
"

